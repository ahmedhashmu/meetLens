# ---------------------------------------------------------------
# MeetLens — environment variables template
#
# Is file ko copy karke ".env" banayein aur asli values daalein:
#     cp .env.example .env
#
# ".env" .gitignore mein hai — wo kabhi commit nahi hogi.
# Asli API keys is file (.env.example) mein KABHI mat likhna.
# ---------------------------------------------------------------

# ===== BACKEND (Railway) =====

# OpenAI — summary, topics, concerns, follow-ups + Whisper transcription
OPENAI_API_KEY=sk-your-key-here

# Neon PostgreSQL — connection string Neon dashboard se milegi
DATABASE_URL=postgresql://user:password@host.neon.tech/meetlens?sslmode=require

# Auth
SECRET_KEY=change-this-to-a-long-random-string

# Frontend ka URL — CORS ke liye
FRONTEND_URL=http://localhost:3000

# Email reminders (follow-up notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password


# ===== FRONTEND (Vercel) =====
# Ye Vercel ke dashboard mein bhi daalna hoga

# Backend ka URL — local: http://localhost:8000, production: Railway URL
NEXT_PUBLIC_API_URL=http://localhost:8000
