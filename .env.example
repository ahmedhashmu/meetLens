# ---------------------------------------------------------------
# MeetLens — environment variables template
#
# Backend:  cp .env.example backend/.env
# Frontend: cp .env.example frontend/.env.local   (sirf NEXT_PUBLIC_ wale)
#
# Asli API keys in files mein KABHI mat likhna — ye repo mein jati hai.
# ---------------------------------------------------------------

# ===== FRONTEND (Vercel) =====
# Supabase dashboard → Project Settings → API
# Yehi dono Vercel ke Environment Variables mein bhi daalni hain.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...


# ===== BACKEND (Railway) =====

# Supabase → Project Settings → Database → Connection string (URI)
# Khaali chhorne par local SQLite use hogi.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# JWT signing key — koi lamba random string
# Banane ke liye:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# OpenAI — summary, topics, concerns, follow-ups + Whisper transcription
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# Frontend ka URL — CORS ke liye (comma se ek se zyada de sakte hain)
FRONTEND_URL=http://localhost:3000

ENVIRONMENT=development

# Email reminders (optional — na don to reminders skip ho jayengi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
